# URL of the Laravel API. Must include the /api/v1 prefix.
# Matches `php artisan serve` started from the Laravel repository.
VITE_APP_API_URL=http://127.0.0.1:8000/api/v1

# Set to true to run against the in-browser MSW mocks instead of the real API.
VITE_APP_ENABLE_API_MOCKING=false

# Public URL of this application, used for links generated by the frontend.
VITE_APP_URL=http://localhost:3000
